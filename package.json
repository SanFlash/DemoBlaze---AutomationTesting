{
  "name": "demoblaze-playwright-automation",
  "version": "2.0.0",
  "private": true,
  "description": "Standard Playwright POM automation framework for DemoBlaze",
  "scripts": {
    "test": "playwright test",
    "test:ci": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:smoke": "playwright test tests/smoke",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "report:allure": "allure generate allure-results --clean -o allure-report",
    "report:allure:open": "allure open allure-report",
    "test:allure": "node scripts/run-with-allure.js",
    "allure:clean": "node -e \"const fs=require('fs'); for(const d of ['allure-results','allure-report']) fs.rmSync(d,{recursive:true,force:true});\""
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "allure-playwright": "3.11.1",
    "allure-commandline": "2.46.1"
  }
}
